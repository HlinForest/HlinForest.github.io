---
import { site } from '../data/site';

const path = Astro.url.pathname;
const active = (href: string) => href === '/#about' ? path === '/' : path.startsWith(href);
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${site.name} 首页`}>
      <span class="brand-name">{site.author}</span>
    </a>
    <div class="header-actions">
      <nav class="site-nav" aria-label="主导航">
        {site.nav.map((item) => (
          <a href={item.href} aria-current={active(item.href) ? 'page' : undefined}>{item.label}</a>
        ))}
        <a href={site.github} rel="me">GitHub ↗</a>
      </nav>
      <button class="icon-button" type="button" data-theme-toggle aria-label="切换深浅主题" title="切换主题">◐</button>
    </div>
  </div>
</header>
