---
import type { CollectionEntry } from 'astro:content';
import { formatDate, postUrl, readingMinutes } from '../utils/posts';

interface Props { post: CollectionEntry<'blog'> }
const { post } = Astro.props;
---

<a class="post-card" href={postUrl(post)}>
  <div class="post-meta">
    <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
    <span>·</span><span>{readingMinutes(post.body)} 分钟</span>
  </div>
  <h3>{post.data.title}</h3>
  <p>{post.data.description}</p>
  <div class="article-tags">
    {post.data.tags.slice(0, 3).map((tag) => <span class="tag">{tag}</span>)}
  </div>
  <span class="arrow">阅读文章 →</span>
</a>
