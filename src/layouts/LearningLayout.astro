---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { learningTitle, learningUrl } from '../utils/learning';

interface Heading { depth: number; slug: string; text: string }
interface Props {
  entry: CollectionEntry<'learning'>;
  entries: CollectionEntry<'learning'>[];
  headings: Heading[];
  previous?: CollectionEntry<'learning'>;
  next?: CollectionEntry<'learning'>;
}
const { entry, entries, headings, previous, next } = Astro.props;
const title = learningTitle(entry);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const groups = [
  { name: '开始', test: (id: string) => /README$/i.test(id) },
  { name: '核心章节', test: (id: string) => id.includes('/chapters/') },
  { name: '实验', test: (id: string) => id.includes('/labs/') },
  { name: '附录', test: (id: string) => id.includes('/appendices/') || /SOURCES$/i.test(id) },
];
---

<BaseLayout title={`${title} | CS336 学习文档`} description="CS336 中文深度学习文档" image="" type="article">
  <div class="reading-progress" data-reading-progress aria-hidden="true"></div>
  <div class="docs-shell">
    <aside class="docs-sidebar" aria-label="学习文档目录">
      <a class="docs-back" href="/learning/">← 全部学习分区</a>
      <div class="docs-course-title">CS336 中文深度笔记</div>
      {groups.map((group) => {
        const items = entries.filter((item) => group.test(item.id));
        return items.length > 0 && <div class="docs-group">
          <p>{group.name}</p>
          {items.map((item) => <a href={learningUrl(item)} aria-current={item.id === entry.id ? 'page' : undefined}>{learningTitle(item)}</a>)}
        </div>;
      })}
    </aside>

    <article class="docs-main">
      <div class="docs-breadcrumb"><a href="/learning/">学习</a><span>/</span><a href="/learning/cs336/">CS336</a></div>
      <div class="prose docs-prose" data-article-body><slot /></div>
      {(previous || next) && (
        <nav class="series-nav" aria-label="上一章与下一章">
          {previous ? <a href={learningUrl(previous)}><small>← 上一章</small><strong>{learningTitle(previous)}</strong></a> : <span></span>}
          {next ? <a href={learningUrl(next)}><small>下一章 →</small><strong>{learningTitle(next)}</strong></a> : <span></span>}
        </nav>
      )}
    </article>

    {toc.length > 0 && (
      <aside class="article-toc docs-toc" aria-label="本页目录">
        <p>On this page</p>
        <ol>{toc.map((heading) => <li class={`depth-${heading.depth}`}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>
      </aside>
    )}
  </div>
  <script>
    const progress = document.querySelector<HTMLElement>('[data-reading-progress]');
    const article = document.querySelector<HTMLElement>('[data-article-body]');
    const update = () => {
      if (!progress || !article) return;
      const top = article.getBoundingClientRect().top + scrollY;
      const distance = Math.max(1, article.scrollHeight - innerHeight * .45);
      progress.style.width = `${Math.max(0, Math.min(1, (scrollY - top + 90) / distance)) * 100}%`;
    };
    addEventListener('scroll', update, { passive: true }); update();

    const mermaidBlocks = [...document.querySelectorAll('pre[data-language="mermaid"] code, code.language-mermaid')];
    if (mermaidBlocks.length) {
      import('mermaid').then(async ({ default: mermaid }) => {
        mermaid.initialize({ startOnLoad: false, theme: document.documentElement.dataset.theme === 'dark' ? 'dark' : 'neutral', securityLevel: 'strict' });
        for (const [index, code] of mermaidBlocks.entries()) {
          const host = code.closest('.expressive-code, pre');
          if (!host) continue;
          try {
            const { svg } = await mermaid.render(`mermaid-${index}`, code.textContent || '');
            const figure = document.createElement('figure'); figure.className = 'rendered-mermaid'; figure.innerHTML = svg; host.replaceWith(figure);
          } catch {}
        }
      });
    }
  </script>
</BaseLayout>
