---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { formatDate, postUrl, readingMinutes } from '../utils/posts';
interface Heading { depth: number; slug: string; text: string }
interface Props { post: CollectionEntry<'blog'>; headings: Heading[]; previous?: CollectionEntry<'blog'>; next?: CollectionEntry<'blog'> }
const { post, headings, previous, next } = Astro.props;
const toc = headings.filter(heading => heading.depth === 2 || heading.depth === 3);
---
<BaseLayout title={`${post.data.title} | Spike`} description={post.data.description} type="article">
  <div class="reading-progress" data-reading-progress aria-hidden="true"></div>
  <div class="back-top-sentinel" data-back-top-sentinel aria-hidden="true"></div>
  <div class="article-shell">
    <aside class="article-rail" aria-label="文章操作">
      <a class="article-back" href="/notes/"><Icon name="arrow-left" size={16} />Notes</a>
      <span class="rail-series">{post.data.series || '随笔'}</span>
      <div class="rail-actions">
        <button class="icon-button" type="button" data-copy-link aria-label="复制文章链接" title="复制链接"><Icon name="link" /><Icon name="check" class="copy-check" /></button>
        <a class="icon-button" href={`https://github.com/HlinForest/HlinForest.github.io/issues/new?title=${encodeURIComponent(`关于：${post.data.title}`)}`} aria-label="在 GitHub 讨论" title="讨论"><Icon name="comment" /></a>
      </div>
      <span class="copy-feedback" role="status" data-article-copy-status></span>
    </aside>
    <article class="article-main">
      <header class="article-head">
        <div class="eyebrow">{post.data.series || 'Essay'}</div>
        <h1>{post.data.title}</h1>
        <p class="article-description">{post.data.description}</p>
        <div class="article-meta">
          <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
          <span>{readingMinutes(post.body)} 分钟阅读</span><span>Spike</span>
          {post.data.updatedAt && <span>更新于 {formatDate(post.data.updatedAt)}</span>}
        </div>
        <div class="article-tags">{post.data.tags.map(tag => <a class="tag" href={`/notes/?tag=${encodeURIComponent(tag)}`}>{tag}</a>)}</div>
      </header>
      <div class="prose" data-article-body><slot /></div>
      {(previous || next) && <nav class="series-nav" aria-label="上一篇与下一篇">
        {previous ? <a href={postUrl(previous)}><small><Icon name="arrow-left" size={16} />上一篇</small><strong>{previous.data.title}</strong></a> : <span></span>}
        {next ? <a href={postUrl(next)}><small>下一篇<Icon name="arrow-right" size={16} /></small><strong>{next.data.title}</strong></a> : <span></span>}
      </nav>}
    </article>
    {toc.length > 0 && <aside class="article-toc" aria-label="文章目录">
      <details data-toc-details>
        <summary>On this page <span>目录</span></summary>
        <ol>{toc.map(heading => <li class={`depth-${heading.depth}`}><a href={`#${heading.slug}`} data-toc-link={heading.slug}>{heading.text}</a></li>)}</ol>
      </details>
    </aside>}
  </div>
  <a class="back-top icon-button" href="#main-content" data-back-top aria-label="回到顶部" title="回到顶部" hidden><Icon name="arrow-up" /></a>
  <script src="../scripts/article.ts"></script>
</BaseLayout>
