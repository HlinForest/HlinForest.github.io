---
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MediaCredit from '../../components/MediaCredit.astro';
import MediaCarousel from '../../components/MediaCarousel.astro';
import { panorama, photos, musicians } from '../../data/misc';
---
<BaseLayout title="Misc | Spike" description="Spike 喜欢的文字、照片与音乐。">
  <div class="misc-page container">
    <header class="page-head"><h1>Misc</h1></header>
    <div class="misc-statement"><p>这里暂时收着一些我喜欢的文字与照片。我还在学习怎样把所见写得更好、拍得更美，便先让它们成为这页的参照。希望有一天，我能用自己的文字和影像，慢慢替换掉这里的收藏。</p></div>
    <section class="misc-section" aria-labelledby="photography-title">
      <header class="misc-section-head"><span aria-hidden="true">01</span><h2 id="photography-title">Photography</h2></header>
      <figure class="photo-panorama">
        <Picture src={panorama.src} alt={panorama.alt} formats={['avif', 'webp']} fallbackFormat="webp" widths={[640, 1120, 1680, 2240]} sizes="(max-width: 1152px) calc(100vw - 32px), 1120px" loading="lazy" />
        <figcaption><strong>{panorama.label}</strong><MediaCredit credit={panorama.credit} /></figcaption>
      </figure>
      <MediaCarousel items={photos} label="东京蓝调时刻与言叶之庭雨景相册">
        <details class="tokyo-story" data-group-content="Tokyo Blue Hour">
          <summary>东京的蓝调时刻</summary>
          <blockquote>
            <p>在天完全黑透之前，落日之后的蓝调时刻给港区的天际线覆上一层淡淡的克莱因蓝。</p>
            <p>玻璃幕墙里开始一盏一盏地亮起灯，这与任何国际大都会的蓝调时刻并无二致，</p>
            <p>直至东京塔的点亮。</p>
            <p>一瞬间红白灯光的亮起在一片寂静的蓝色中形成了鲜明的冷暖对比。真正看到《东京教父》、《天气之子》等等无数影视作品中亮起的红白铁塔的这一刻，我心目中的东京才真正具像化。</p>
          </blockquote>
        </details>
      </MediaCarousel>
    </section>
    <section class="misc-section music-section" aria-labelledby="music-title">
      <header class="misc-section-head"><span aria-hidden="true">02</span><h2 id="music-title">My favorite musicians</h2></header>
      <MediaCarousel items={musicians} kind="music" label="喜欢的音乐人肖像" />
    </section>
  </div>
  <script src="../../scripts/carousel.ts"></script>
</BaseLayout>
