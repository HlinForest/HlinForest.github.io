---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
---

<BaseLayout title="Misc | Spike" description="Spike 喜欢的文字、照片与音乐。" image="/tokyo-skyscanner-reference.png">
  <section class="misc-page container" aria-labelledby="misc-title">
    <header class="misc-head">
      <div class="eyebrow">Misc</div>
      <h1 id="misc-title">Misc</h1>
    </header>

    <div class="misc-statement">
      <p>
        这里暂时收着一些我喜欢的文字与照片。我还在学习怎样把所见写得更好、拍得更美，便先让它们成为这页的参照。希望有一天，我能用自己的文字和影像，慢慢替换掉这里的收藏。
      </p>
      <a href="https://www.skyscanner.com.hk/news/bc/stories-of-our-favourite-travel-photos">
        Visual reference · Skyscanner travel stories <span aria-hidden="true">↗</span>
      </a>
    </div>

    <section class="misc-section" aria-labelledby="photography-title">
      <header class="misc-section-head">
        <span aria-hidden="true">01</span>
        <h2 id="photography-title">Photography</h2>
      </header>

      <figure class="photo-feature tokyo-feature">
        <div
          class="photo-feature-frame"
          data-photo-reveal
          role="button"
          tabindex="0"
          aria-expanded="false"
          aria-label="东京蓝调时刻，悬停或点击阅读文字"
        >
          <img
            src="/tokyo-skyscanner-reference.png"
            alt="蓝调时刻的东京天际线、东京塔与远处的富士山"
            width="3157"
            height="796"
          />
          <div class="photo-reveal" data-photo-overlay aria-hidden="true">
            <blockquote>
              <p>在天完全黑透之前，落日之后的蓝调时刻给港区的天际线覆上一层淡淡的克莱因蓝。</p>
              <p>玻璃幕墙里开始一盏一盏地亮起灯，这与任何国际大都会的蓝调时刻并无二致，</p>
              <p>直至东京塔的点亮。</p>
              <p>一瞬间红白灯光的亮起在一片寂静的蓝色中形成了鲜明的冷暖对比。真正看到《东京教父》、《天气之子》等等无数影视作品中亮起的红白铁塔的这一刻，我心目中的东京才真正具像化。</p>
            </blockquote>
          </div>
        </div>
        <figcaption>
          <span>Tokyo · Blue hour</span>
          <span class="photo-meta">
            Favorite image · Skyscanner reference · 悬停或点击阅读<br />
            <a href="https://www.sina.cn/news/detail/5155104072140071.html">
              Text &amp; image reference · _等待夏夜吹成烈焰 / 新浪 <span aria-hidden="true">↗</span>
            </a>
          </span>
        </figcaption>
      </figure>
    </section>

    <section class="misc-section" aria-labelledby="music-title">
      <header class="misc-section-head">
        <span aria-hidden="true">02</span>
        <h2 id="music-title">my favorite musician</h2>
      </header>

      <div class="music-carousel" data-music-carousel tabindex="0" aria-label="喜欢的音乐人肖像">
        <div class="music-slides" aria-live="polite">
          <article class="music-slide" data-music-slide>
            <figure class="music-portrait">
              <div class="music-portrait-frame">
                <img src={site.portrait} alt={site.portraitAlt} width="1090" height="1451" loading="lazy" />
              </div>
              <blockquote class="music-quote">也没有一时澎湃悸动，却在深秋细水长流。</blockquote>
              <figcaption>
                <strong>方大同</strong>
                <span>
                  After <a href={site.portraitSource}>Khalil Fong, 2007 · Verity</a>
                  · AI-transformed · <a href={site.portraitLicense}>CC BY-SA 2.0</a>
                </span>
              </figcaption>
            </figure>
          </article>

          <article class="music-slide" data-music-slide hidden>
            <figure class="music-portrait">
              <div class="music-portrait-frame">
                <img
                  src="/zhang-yusheng-impressionist-portrait.png"
                  alt="张雨生年轻时期的印象派肖像画"
                  width="1110"
                  height="1480"
                  loading="lazy"
                />
              </div>
              <blockquote class="music-quote two-lines">
                <span>我的胸口鼓鼓吹胀</span>
                <span>欢乐幸福的遐想</span>
              </blockquote>
              <figcaption>
                <strong>张雨生</strong>
                <span>AI-generated impressionist portrait study</span>
              </figcaption>
            </figure>
          </article>
        </div>

        <nav class="music-controls" aria-label="切换肖像">
          <button type="button" data-music-prev aria-label="上一张肖像">←</button>
          <div class="music-dots" role="group" aria-label="选择肖像">
            <button type="button" data-music-dot="0" aria-label="查看方大同肖像" aria-pressed="true">01</button>
            <button type="button" data-music-dot="1" aria-label="查看张雨生肖像" aria-pressed="false">02</button>
          </div>
          <button type="button" data-music-next aria-label="下一张肖像">→</button>
        </nav>
      </div>
    </section>
  </section>

  <script>
    const photoReveal = document.querySelector<HTMLElement>('[data-photo-reveal]');
    const photoOverlay = photoReveal?.querySelector<HTMLElement>('[data-photo-overlay]');

    const setPhotoOpen = (open: boolean) => {
      photoReveal?.classList.toggle('is-open', open);
      photoReveal?.setAttribute('aria-expanded', String(open));
      photoOverlay?.setAttribute('aria-hidden', String(!open));
    };

    photoReveal?.addEventListener('click', () => {
      setPhotoOpen(photoReveal.getAttribute('aria-expanded') !== 'true');
    });
    photoReveal?.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        setPhotoOpen(photoReveal.getAttribute('aria-expanded') !== 'true');
      }
      if (event.key === 'Escape') setPhotoOpen(false);
    });

    const carousel = document.querySelector<HTMLElement>('[data-music-carousel]');
    const slides = [...document.querySelectorAll<HTMLElement>('[data-music-slide]')];
    const dots = [...document.querySelectorAll<HTMLButtonElement>('[data-music-dot]')];
    let currentSlide = 0;

    const showSlide = (next: number) => {
      currentSlide = (next + slides.length) % slides.length;
      slides.forEach((slide, index) => {
        const active = index === currentSlide;
        slide.hidden = !active;
        slide.setAttribute('aria-hidden', String(!active));
      });
      dots.forEach((dot, index) => dot.setAttribute('aria-pressed', String(index === currentSlide)));
    };

    document.querySelector('[data-music-prev]')?.addEventListener('click', () => showSlide(currentSlide - 1));
    document.querySelector('[data-music-next]')?.addEventListener('click', () => showSlide(currentSlide + 1));
    dots.forEach((dot) => dot.addEventListener('click', () => showSlide(Number(dot.dataset.musicDot))));
    carousel?.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') showSlide(currentSlide - 1);
      if (event.key === 'ArrowRight') showSlide(currentSlide + 1);
    });
    showSlide(0);
  </script>
</BaseLayout>
