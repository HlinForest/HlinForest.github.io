---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { byNewest, formatDate, postUrl, publishedOnly, readingMinutes } from '../../utils/posts';
const posts = (await getCollection('blog')).filter(publishedOnly).sort(byNewest);
const tags = [...new Set(posts.flatMap(post => post.data.tags))].sort();
const sections = [...new Set(posts.map(post => post.data.series || '随笔'))].sort();
---
<BaseLayout title="Notes | Spike" description="Spike 的学习笔记，记录推导、实现与理解。">
  <header class="page-head container">
    <p class="eyebrow">Archive · {posts.length} 篇</p>
    <h1>Notes</h1>
    <p>记录学习中的推导、实现，以及一点点理解。</p>
  </header>
  <section class="notes-list container" aria-label="笔记列表">
    {posts.length > 1 && (sections.length > 1 || tags.length > 1) && <div class="filter-toolbar">
      {sections.length > 1 && <div class="filter-group" role="group" aria-label="按分区筛选">
        <span>分区</span><div class="filter-row">
          <button class="filter-button" type="button" data-section="all" aria-pressed="true">全部分区</button>
          {sections.map(section => <button class="filter-button" type="button" data-section={section} aria-pressed="false">{section}</button>)}
        </div>
      </div>}
      {tags.length > 1 && <div class="filter-group" role="group" aria-label="按标签筛选">
        <span>标签</span><div class="filter-row">
          <button class="filter-button" type="button" data-filter="all" aria-pressed="true">全部标签</button>
          {tags.map(tag => <button class="filter-button" type="button" data-filter={tag} aria-pressed="false">{tag}</button>)}
        </div>
      </div>}
    </div>}
    <div class="active-filters" data-active-filters hidden><span data-filter-description></span><button type="button" class="filter-button" data-clear-filters>清除筛选</button></div>
    <div data-post-list>
      {posts.map(post => <a class="post-row" href={postUrl(post)} data-tags={JSON.stringify(post.data.tags)} data-series={post.data.series || '随笔'}>
        <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
        <div><h2>{post.data.title}</h2><p>{post.data.description}</p><span class="post-reading">{post.data.series || '随笔'} · {readingMinutes(post.body)} 分钟阅读</span></div>
        <div class="post-row-tags">{post.data.tags.slice(0, 2).map(tag => <span class="tag">{tag}</span>)}</div>
      </a>)}
    </div>
    <p class="empty-state" data-empty-state hidden={posts.length > 0}>没有符合条件的笔记。</p>
    <p class="sr-only" role="status" data-filter-status></p>
  </section>
  <script src="../../scripts/notes.ts"></script>
</BaseLayout>
