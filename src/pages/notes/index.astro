---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { byNewest, formatDate, postUrl, publishedOnly, readingMinutes } from '../../utils/posts';

const posts = (await getCollection('blog')).filter(publishedOnly).sort(byNewest);
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
const sections = [...new Set(posts.map((post) => post.data.series || '随笔'))].sort();
---

<BaseLayout title="Notes | Spike" description="Spike 的笔记。">
  <header class="notes-index-head container">
    <div class="eyebrow">Notes</div>
    <h1>Notes</h1>
  </header>

  {posts.length > 0 && (
    <section class="container">
      <div class="filter-toolbar">
        <div class="filter-group" aria-label="按分区筛选">
          <span>分区</span>
          <div class="filter-row">
            <button class="filter-button" type="button" data-section="all" aria-pressed="true">全部分区</button>
            {sections.map((section) => <button class="filter-button" type="button" data-section={section} aria-pressed="false">{section}</button>)}
          </div>
        </div>
        <div class="filter-group" aria-label="按标签筛选">
          <span>标签</span>
          <div class="filter-row">
            <button class="filter-button" type="button" data-filter="all" aria-pressed="true">全部标签</button>
            {tags.map((tag) => <button class="filter-button" type="button" data-filter={tag} aria-pressed="false">{tag}</button>)}
          </div>
        </div>
      </div>
      <div class="post-list" data-post-list>
        {posts.map((post) => (
          <a class="post-row" href={postUrl(post)} data-tags={post.data.tags.join('|')} data-series={post.data.series || '随笔'}>
            <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
            <div><h2>{post.data.title}</h2><p>{post.data.description} · {readingMinutes(post.body)} 分钟</p></div>
            <div class="post-row-tags">{post.data.tags.slice(0, 2).map((tag) => <span class="tag">{tag}</span>)}</div>
          </a>
        ))}
      </div>
    </section>
  )}

  {posts.length > 0 && (
    <script>
      const tagButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
      const sectionButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-section]')];
      const rows = [...document.querySelectorAll<HTMLElement>('[data-tags]')];
      const params = new URLSearchParams(location.search);
      let activeTag = params.get('tag') || 'all';
      let activeSection = params.get('section') || 'all';
      const applyFilters = () => {
        tagButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.filter === activeTag)));
        sectionButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.section === activeSection)));
        rows.forEach((row) => {
          const tagMatch = activeTag === 'all' || (row.dataset.tags || '').split('|').includes(activeTag);
          const sectionMatch = activeSection === 'all' || row.dataset.series === activeSection;
          row.toggleAttribute('hidden', !(tagMatch && sectionMatch));
        });
      };
      tagButtons.forEach((button) => button.addEventListener('click', () => { activeTag = button.dataset.filter || 'all'; applyFilters(); }));
      sectionButtons.forEach((button) => button.addEventListener('click', () => { activeSection = button.dataset.section || 'all'; applyFilters(); }));
      applyFilters();
    </script>
  )}
</BaseLayout>
