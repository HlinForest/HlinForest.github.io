---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout image="/spike-profile-space.webp">
  <section class="profile-home container" id="about" aria-labelledby="spike-name">
    <aside class="profile-identity">
      <figure class="profile-avatar">
        <img
          src="/spike-profile-space.webp"
          alt="太空舱中的 Spike 演奏萨克斯"
          width="1672"
          height="941"
        />
        <figcaption>AI study · France Olympic space saxophone, Spike adaptation</figcaption>
      </figure>

      <h1 id="spike-name">Spike</h1>
      <a class="identity-link" href={site.github} rel="me">
        GitHub <span aria-hidden="true">↗</span>
      </a>
    </aside>

    <div class="profile-introduction">
      <div class="about-label">About</div>
      <p>我还在学习中，会慢慢更新的。</p>
    </div>
  </section>
</BaseLayout>
