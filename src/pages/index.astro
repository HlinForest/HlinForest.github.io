---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout image="/spike-spiegel-portrait.png">
  <section class="profile-home container" id="about" aria-labelledby="spike-name">
    <aside class="profile-identity">
      <figure class="profile-avatar">
        <img
          src="/spike-spiegel-portrait.png"
          alt="星际牛仔 Spike 的原创动漫肖像"
          width="1024"
          height="1280"
        />
        <figcaption>Original fan art · AI-generated</figcaption>
      </figure>

      <h1 id="spike-name">Spike</h1>
      <a class="identity-link" href={site.github} rel="me">
        GitHub <span aria-hidden="true">↗</span>
      </a>
    </aside>

    <div class="profile-introduction">
      <div class="about-label">About</div>
      <p>我还在学习中，会慢慢更新的。</p>
    </div>
  </section>
</BaseLayout>
