---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout>
  <section class="about-landing container" id="about" aria-labelledby="spike-name">
    <div class="about-identity">
      <div class="about-label">About</div>
      <h1 id="spike-name">Spike</h1>
      <div class="identity-rule" aria-hidden="true"></div>
      <a class="identity-link" href={site.github} rel="me">
        GitHub <span aria-hidden="true">↗</span>
      </a>
    </div>

    <div class="home-mark" role="img" aria-label="Spike 字母视觉">
      <span>S</span>
    </div>
  </section>
</BaseLayout>
