---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { learningTracks } from '../utils/learning';
import { byNewest, formatDate, postUrl, publishedOnly } from '../utils/posts';

const notes = (await getCollection('blog')).filter(publishedOnly).sort(byNewest).slice(0, 3);
---

<BaseLayout>
  <section class="portfolio-hero container minimal-hero">
    <figure class="portrait-panel">
      <div class="portrait-frame">
        <img src={site.portrait} alt={site.portraitAlt} width="901" height="1356" />
      </div>
      <figcaption>
        <span>Visual reference</span>
        <span class="photo-credit">
          <a href={site.portraitSource}>Khalil Fong, 2007 · Verity</a>
          · <a href={site.portraitLicense}>CC BY-SA 2.0</a>
        </span>
      </figcaption>
    </figure>

    <div class="portfolio-intro minimal-intro">
      <h1>Spike</h1>
      <div class="portfolio-actions">
        <a class="text-action primary" href="/learning/">Notes <span aria-hidden="true">→</span></a>
        <a class="text-action" href={site.github}>GitHub <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="academic-section container empty-academic-section" id="research">
    <div class="academic-section-head single">
      <div><div class="eyebrow">Research interests</div><h2>Research interests</h2></div>
    </div>
    <div class="empty-field" aria-hidden="true"></div>
  </section>

  <section class="academic-section selected-section empty-academic-section">
    <div class="container">
      <div class="academic-section-head inverse single">
        <div><div class="eyebrow">Selected work</div><h2>Papers</h2></div>
      </div>
      <div class="empty-field inverse" aria-hidden="true"></div>
    </div>
  </section>

  <section class="academic-section container notes-section">
    <div class="academic-section-head single">
      <div><div class="eyebrow">Notes</div><h2>Notes</h2></div>
    </div>

    <div class="notes-block">
      <div class="notes-block-head"><span>Writing</span><a href="/blog/">All notes →</a></div>
      <div class="academic-writing-list">
        {notes.map((note) => (
          <a href={postUrl(note)}>
            <time datetime={note.data.publishedAt.toISOString()}>{formatDate(note.data.publishedAt)}</time>
            <div><h3>{note.data.title}</h3><p>{note.data.description}</p></div>
            <span aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>

    <div class="notes-block collections-block">
      <div class="notes-block-head"><span>Collections</span><a href="/learning/">All collections →</a></div>
      <div class="notes-collections">
        {learningTracks.map((track, index) => (
          <a href={track.href}>
            <span>0{index + 1} · {track.area}</span>
            <h3>{track.title}</h3>
            <small>{track.count}</small>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
