---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout>
  <section class="about-landing container" id="about" aria-labelledby="spike-name">
    <div class="about-identity">
      <div class="about-label">About</div>
      <h1 id="spike-name">Spike</h1>
      <div class="identity-rule" aria-hidden="true"></div>
      <a class="identity-link" href={site.github} rel="me">
        GitHub <span aria-hidden="true">↗</span>
      </a>
    </div>

    <figure class="art-portrait">
      <div class="art-portrait-frame">
        <img src={site.portrait} alt={site.portraitAlt} width="1090" height="1451" />
      </div>
      <blockquote class="portrait-quote">也没有一时澎湃悸动，却在深秋细水长流。</blockquote>
      <figcaption>
        <span>Impressionist portrait study</span>
        <span>
          After <a href={site.portraitSource}>Khalil Fong, 2007 · Verity</a>
          · AI-transformed · <a href={site.portraitLicense}>CC BY-SA 2.0</a>
        </span>
      </figcaption>
    </figure>
  </section>
</BaseLayout>
