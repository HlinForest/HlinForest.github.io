---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Research | Spike" description="Spike 的研究页面。">
  <header class="research-hero container sparse-research-hero">
    <div class="eyebrow">Research</div>
    <h1>Research</h1>
  </header>

  <main class="container sparse-research-page">
    <section>
      <div class="eyebrow">Research interests</div>
      <h2>Research interests</h2>
      <div class="empty-field" aria-hidden="true"></div>
    </section>
    <section>
      <div class="eyebrow">Selected work</div>
      <h2>Papers</h2>
      <div class="empty-field" aria-hidden="true"></div>
    </section>
  </main>
</BaseLayout>
