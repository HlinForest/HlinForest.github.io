---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
---

<BaseLayout title="About Spike" description="About Spike.">
  <header class="academic-page-head container">
    <div class="eyebrow">About</div>
    <h1>Spike</h1>
  </header>

  <section class="container bio-layout sparse-bio">
    <aside class="bio-portrait">
      <img src={site.portrait} alt={site.portraitAlt} width="901" height="1356" />
      <p class="standalone-photo-credit">
        Visual reference: <a href={site.portraitSource}>Khalil Fong, 2007 · Verity</a><br />
        <a href={site.portraitLicense}>CC BY-SA 2.0</a>
      </p>
    </aside>

    <div class="bio-copy prose-like blank-profile-fields">
      <section><h2>Bio</h2><div class="empty-field" aria-hidden="true"></div></section>
      <section><h2>Research interests</h2><div class="empty-field" aria-hidden="true"></div></section>
      <section><h2>Contact</h2><div class="empty-field" aria-hidden="true"></div></section>
    </div>
  </section>
</BaseLayout>
